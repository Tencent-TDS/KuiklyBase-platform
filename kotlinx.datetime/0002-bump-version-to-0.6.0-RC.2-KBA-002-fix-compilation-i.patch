-package kotlinx.datetime.internal
-
-import com.tencent.tmm.knoi.annotation.ServiceConsumer
-import com.tencent.tmm.knoi.type.JSValue
-import com.tencent.tmm.knoi.module.loadModuleToJSValueWithInfo
-import kotlinx.datetime.KMMDateTimeLog
-import kotlinx.atomicfu.atomic
-import kotlinx.atomicfu.update
-import kotlinx.atomicfu.updateAndGet
-
-/**
- * Copyright (c) 2025 Tencent. All rights reserved.
- *
- * @Author : woodyjjli
- * @date : 2025/9/24
- */
-
-@ServiceConsumer
-public interface TimeZoneManagerService {
-
-    public fun getTimeZone(id: String?): JSValue
-
-    public fun getAvailableIDs(): List<String>
-
-    public fun setTimeZoneChangeCallback(callback: () -> Unit)
-}
-
-
-internal object TimeZoneManager {
-    private val delegate = TimeZoneManagerDelegate()
-    // Stately系列未开源，先用atomic来实现线程安全的map
-    private val timeZoneCache = atomic<Map<String, TMMTimeZone>>(emptyMap())
-    private var defaultTimeZoneCache: TMMTimeZone? = null
-    private var availableIdsCache: Array<String>? = null
-
-    fun getTimeZone(id: String): TMMTimeZone {
-        return timeZoneCache.updateAndGet { currentCache ->
-            if (id in currentCache) {
-                currentCache
-            } else {
-                currentCache + (id to delegate.getTimeZone(id))
-            }
-        }[id] ?: getDefaultTimeZone()
-    }
-
-    fun getDefaultTimeZone(): TMMTimeZone {
-        return defaultTimeZoneCache ?: delegate.getDefaultTimeZone()
-            .also { defaultTimeZoneCache = it }
-    }
-
-    fun getAvailableIDs(): Array<String> {
-        return availableIdsCache ?: delegate.getAvailableIDs()
-            .also { availableIdsCache = it }
-    }
-
-    // 时区变化时主动通知缓存作废
-    fun clearCache() {
-        KMMDateTimeLog.i("[TimeZone]","clearCache")
-        timeZoneCache.update {
-            emptyMap()
-        }
-        defaultTimeZoneCache = null
-        availableIdsCache = null
-    }
-}
-
-internal class TimeZoneManagerDelegate() {
-
-    init {
-        // 注册时区变化回调
-        getTimeZoneManagerServiceApi().setTimeZoneChangeCallback{
-            TimeZoneManager.clearCache()
-        }
-    }
-
-    private fun transformJSValueToTimeZone(jsValue: JSValue): TMMTimeZone {
-        val id = jsValue["id"]?.toKString() ?: ""
-        val displayName = jsValue["displayName"]?.toKString() ?: ""
-        val rawOffset = jsValue["rawOffset"]?.toInt() ?: 0
-        return TMMTimeZone(id, displayName, rawOffset)
-    }
-
-    fun getTimeZone(id: String): TMMTimeZone {
-        val jsValue = getTimeZoneManagerServiceApi().getTimeZone(id)
-        return transformJSValueToTimeZone(jsValue)
-    }
-
-    fun getDefaultTimeZone(): TMMTimeZone {
-        val jsValue = getTimeZoneManagerServiceApi().getTimeZone(null)
-        return transformJSValueToTimeZone(jsValue)
-    }
-
-    fun getAvailableIDs(): Array<String> {
-        return getTimeZoneManagerServiceApi().getAvailableIDs().toTypedArray()
-    }
-
-}
-
-internal data class TMMTimeZone(val id: String, val displayName: String, val rawOffset: Int) {
-    override fun toString(): String {
-        return "TMMTimeZone(id='$id', displayName='$displayName', rawOffset=$rawOffset)"
-    }
-}
