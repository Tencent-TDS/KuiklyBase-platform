@@ -0,0 +1,13 @@
+package kotlinx.datetime.api
+
+private var systemDefaultZoneProvider: () -> String = {
+    "Asia/Shanghai"
+}
+
+internal fun getSystemDefaultZone(): String {
+    return systemDefaultZoneProvider()
+}
+
+public fun injectSystemDefaultZone(provider: () -> String) {
+    systemDefaultZoneProvider = provider
+}
