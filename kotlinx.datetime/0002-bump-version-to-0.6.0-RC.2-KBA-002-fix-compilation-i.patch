+internal actual val systemTzdb: TimeZoneDatabase get() = tzdb.getOrThrow()
+
+private val tzdb = runCatching {
+    OhosTimeZoneDatabase()
+}
+
+internal actual fun currentSystemDefaultZone(): Pair<String, TimeZoneRules?> {
+    val zone = getSystemDefaultZone()
+    val offset = timezoneToOffset[zone] ?: 0
+    val rules = TimeZoneRules(emptyList(), listOf(UtcOffset(seconds = offset / 1000)), null)
+    return zone to rules
+}
+
+internal class OhosTimeZoneDatabase : TimeZoneDatabase {
+    override fun rulesForId(id: String): TimeZoneRules {
+        val offset = timezoneToOffset[id] ?: 0
+        return TimeZoneRules(emptyList(), listOf(UtcOffset(seconds = offset / 1000)), null)
+    }
+
+    override fun availableTimeZoneIds(): Set<String> {
+        return timezoneToOffset.keys.toSet()
+    }
+
