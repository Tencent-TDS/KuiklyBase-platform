diff --git a/ohosApp/timezone/src/main/ets/components/TimeZoneManager.ets b/ohosApp/timezone/src/main/ets/components/TimeZoneManager.ets
new file mode 100644
index 0000000..13f737e
--- /dev/null
+++ b/ohosApp/timezone/src/main/ets/components/TimeZoneManager.ets
@@ -0,0 +1,51 @@
+import { registerServiceProvider } from '@kuiklybase/knoi';
+import I18n from '@ohos.i18n';
+import { BusinessError, commonEventManager } from '@kit.BasicServicesKit';
+
+let timeZoneChangeCallback: Function
+
+class TimeZoneManager {
+    subscriber: commonEventManager.CommonEventSubscriber;
+
+    constructor() {
+        registerServiceProvider("TimeZoneManagerService", true, TimeZoneManager);
+        this.subscriber = commonEventManager.createSubscriberSync({
+            events: [commonEventManager.Support.COMMON_EVENT_TIMEZONE_CHANGED]
+        })
+    }
+
+    getTimeZone(id: string | undefined): Record<string, string | number> {
+        let timezone = I18n.getTimeZone(id)
+        return {
+            "id": timezone.getID(),
+            "displayName": timezone.getDisplayName(),
+            "rawOffset": timezone.getRawOffset()
+        }
+    }
+
+    getAvailableIDs(): Array<string> {
+        return I18n.TimeZone.getAvailableIDs()
+    }
+
+    setTimeZoneChangeCallback(callback: Function) {
+        this.subscribeTimeZoneChangeEvent()
+        timeZoneChangeCallback = callback
+    }
+
+    subscribeTimeZoneChangeEvent() {
+        commonEventManager.subscribe(this.subscriber,
+            (err: BusinessError, data: commonEventManager.CommonEventData) => {
+                if (err) {
+                    return;
+                }
+                // // 通知KMM层时区缓存失效
+                // console.info(`[TimeZone] timezone is change, callback is not null : ${timeZoneChangeCallback !=
+                //     undefined}`);
+                if (timeZoneChangeCallback != undefined) {
+                    timeZoneChangeCallback()
+                }
+            })
+    }
+}
+
+export default new TimeZoneManager()
\ No newline at end of file
