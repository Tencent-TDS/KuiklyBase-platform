@@ -0,0 +1,48 @@
+Gzip or Zip demo
+===============
+
+
+## 使用OKIO的压缩能力进行压缩和解压缩
+
+### 1. GZIP 压缩
+
+```kotlin
+fun gzipSink(sourceString: String): String {
+    val data = Buffer()
+    (data as Sink).gzip().buffer().use { gzip ->
+        gzip.writeUtf8(sourceString)
+    }
+    return data.readByteString().hex()
+}
+```
+基本思路就是构建 Sink 输出类之后，拿到 buffer 往 buffer 里写入需要压缩的源。
+
+结合 OKIO 的 `fileSystem.sink()`可以实现往文件里压缩源数据的功能
+
+
+### 2. GZIP 解压缩
+
+```kotlin
+internal fun gzipSource(sinkString: String): String? {
+    val buffer = Buffer().write(sinkString.decodeHex())
+    var res: String? = null
+    (buffer as Source).gzip().buffer().use { gzip ->
+        res = gzip.readUtf8()
+    }
+    return res
+}
+```
+基本思路就是构建 Source 输入类之后，拿到 buffer 从 buffer 里读出已经压缩的源。
+
+结合 OKIO 的 `fileSystem.source()`可以实现从文件里读取源数据的功能
+
+
+### 3. ZIP 解压缩文件
+```kotlin
+internal fun openZip(path: String) {
+    val zipPath = path.toPath()
+    val zipFileSystem = fileSystem.openZip(zipPath)
+    logger(zipFileSystem.list("/".toPath()).toString())
+}
+```
+通过 OKio 提供的文件管理系统，即可打开已经下载好的 zip 文件，可以从这个系统里去获取对于的文件去拿到源文件，读取流，具体可以参考 okio 的使用方式
