diff --git a/benchmark/src/jmh/kotlin/kotlinx/benchmarks/json/TwitterFeedCommentsBenchmark.kt b/benchmark/src/jmh/kotlin/kotlinx/benchmarks/json/TwitterFeedCommentsBenchmark.kt
deleted file mode 100644
--- a/benchmark/src/jmh/kotlin/kotlinx/benchmarks/json/TwitterFeedCommentsBenchmark.kt	(revision 4c112bf10aa42f5f7ecc0524113f8ff73de8a587)
+++ /dev/null	(revision 4c112bf10aa42f5f7ecc0524113f8ff73de8a587)
@@ -1,64 +0,0 @@
-/*
