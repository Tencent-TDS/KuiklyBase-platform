+  (KNativePointer ptr, KFloat distance, KFloat* data) {
+    SkPathMeasure* instance = reinterpret_cast<SkPathMeasure*>((ptr));
+    SkPoint position;
+    if (instance->getPosTan(distance, &position, nullptr)) {
+        data[0] = position.fX;
+        data[1] = position.fY;
