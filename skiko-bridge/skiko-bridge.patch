+
+class GrBackendSemaphore;
+class GrBackendTexture;
+class GrRecordingContext;
+class GrSurfaceCharacterization;
+enum GrSurfaceOrigin : int;
+class SkBitmap;
+class SkCanvas;
+class SkCapabilities;
