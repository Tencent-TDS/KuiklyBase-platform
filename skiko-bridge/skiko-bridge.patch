+U_CAPI int32_t U_EXPORT2
+udata_getLength(const UDataMemory *pData);
+
+U_CAPI const void * U_EXPORT2
+udata_getRawMemory(const UDataMemory *pData);
+
+#endif
diff --git a/skikobridge/src/main/cpp/skia/third_party/externals/icu/source/common/udataswp.h b/skikobridge/src/main/cpp/skia/third_party/externals/icu/source/common/udataswp.h
