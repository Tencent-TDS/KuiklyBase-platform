+    SkTileMode tmy = static_cast<SkTileMode>(tmyValue);
+    SkFilterMode filterMode = static_cast<SkFilterMode>(filterModeValue);
+    std::unique_ptr<SkMatrix> localMatrix = skMatrix(localMatrixArr);
