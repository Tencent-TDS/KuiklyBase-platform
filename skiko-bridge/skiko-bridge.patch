+SKIKO_EXPORT void
+org_jetbrains_skia_shaper_Shaper__1nShape(KNativePointer ptr, KNativePointer textPtr, KInteropPointer fontRunIterObj,
+                                          KInteropPointer bidiRunIterObj, KInteropPointer scriptRunIterObj,
+                                          KInteropPointer languageRunIterObj, KInt optsFeaturesLen, KInt *optsFeatures,
+                                          KInt optsBooleanProps, KFloat width, KInteropPointer runHandlerObj) {
+    auto *instance = reinterpret_cast<SkShaper *>(ptr);
