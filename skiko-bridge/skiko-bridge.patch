+#endif
+
+#if !defined(SK_DISABLE_LEGACY_SKSURFACE_FLUSH)
+    void flushAndSubmit(bool syncCpu = false);
+    void flush();
+#endif
+
+#if !defined(SK_DISABLE_LEGACY_SKSURFACE_AS_IMAGE) && defined(SK_GRAPHITE)
+    sk_sp<SkImage> asImage();
+#endif
+
+};
