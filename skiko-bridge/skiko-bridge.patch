+cmake_minimum_required(VERSION 3.4.1)
+project(SkikoBridge)
+
+set(NATIVERENDER_ROOT_PATH ${CMAKE_CURRENT_SOURCE_DIR})
+
+if(DEFINED PACKAGE_FIND_FILE)
+    include(${PACKAGE_FIND_FILE})
+endif()
+
+#处理头文件的搜索路径
+include_directories(${NATIVERENDER_ROOT_PATH})
+include_directories(${NATIVERENDER_ROOT_PATH}/include)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia)
+include_directories(${NATIVERENDER_ROOT_PATH}/src/commonMain/cpp/common/include)
+include_directories(${NATIVERENDER_ROOT_PATH}/src/nativeJsMain/cpp)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/include/core)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/include/codec)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/include/effects)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/include/gpu)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/include/gpu/gl)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/modules/skshaper/include)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/modules/sksg/include)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/modules/skottie/include)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/modules/svg/include)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/modules/skparagraph/include)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/third_party/icu)
+include_directories(${NATIVERENDER_ROOT_PATH}/skia/third_party/externals/icu/source/common)
+
+# 将 ${NATIVERENDER_ROOT_PATH}/**/*.cpp 所有的文件路径保存在 SOURCES 这个变量中
+file(
+GLOB_RECURSE SOURCES
+${NATIVERENDER_ROOT_PATH}/src/commonMain/cpp/common/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/ohosMain/event/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/ohosMain/dispatcher/*.cpp
+
+${NATIVERENDER_ROOT_PATH}/src/nativeJsMain/cpp/icu/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/nativeJsMain/cpp/paragraph/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/nativeJsMain/cpp/shaper/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/nativeJsMain/cpp/skottie/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/nativeJsMain/cpp/sksg/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/nativeJsMain/cpp/svg/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/nativeJsMain/cpp/*.cpp
+${NATIVERENDER_ROOT_PATH}/src/commonMain/cpp/common/mppinterop.cpp
+${NATIVERENDER_ROOT_PATH}/src/commonMain/cpp/common/shaper/FontRunIterator.cpp
+)
+
+#处理C++版本相关
+add_definitions(-std=c++17)
+add_definitions(-Wno-nonportable-include-path)
+add_definitions(-Wno-unused-command-line-argument)
+add_definitions(-DU_DISABLE_RENAMING)
+
+#处理宏定义
+add_definitions(-DSK_RELEASE=1)
+add_definitions(-DSKNX_NO_SIMD=1)
+add_definitions(-DSK_GL=1)
+add_definitions(-DSK_ENABLE_SKSL)
+add_definitions(-DSK_GANESH)
+add_definitions(-DSK_UNICODE_AVAILABLE)
+add_definitions(-DSK_GPU_V1=0)
+add_definitions(-DSK_BUILD_FONT_MGR_FOR_OHOS)
+add_definitions(-DSK_SHAPER_HARFBUZZ_AVAILABLE)
+add_definitions(-DSK_ALLOW_STATIC_GLOBAL_INITIALIZERS=1)
+add_definitions(-DSK_FORCE_DISTANCE_FIELD_TEXT=0)
+add_definitions(-DSK_GAMMA_APPLY_TO_A8)
+add_definitions(-DSK_GAMMA_SRGB)
+add_definitions(-DSK_SCALAR_TO_FLOAT_EXCLUDED)
+add_definitions(-DSK_SUPPORT_GPU=1)
+add_definitions(-DSK_UNICODE_AVAILABLE)
+add_definitions(-DSK_SUPPORT_OPENCL=0)
+add_definitions(-DSK_USING_THIRD_PARTY_ICU)
+
+add_library(skikobridge SHARED napi_init.cpp ${SOURCES})
+
+find_library(
+    # Sets the name of the path variable.
+    EGL-lib
+    # Specifies the name of the NDK library that
+    # you want CMake to locate.
+    EGL
+)
+
+find_library(
+    # Sets the name of the path variable.
+    GLES-lib
+    # Specifies the name of the NDK library that
+    # you want CMake to locate.
+    GLESv3
+)
+
+find_library(
+    # Sets the name of the path variable.
+    hilog-lib
+    # Specifies the name of the NDK library that
+    # you want CMake to locate.
+    hilog_ndk.z
+)
+
+find_library(
+    # Sets the name of the path variable.
+    libace-lib
+    # Specifies the name of the NDK library that
+    # you want CMake to locate.
+    ace_ndk.z
+)
+
+find_library(
+    # Sets the name of the path variable.
+    libnapi-lib
+    # Specifies the name of the NDK library that
+    # you want CMake to locate.
+    ace_napi.z
+)
+
+find_library(
+    # Sets the name of the path variable.
+    libuv-lib
+    # Specifies the name of the NDK library that
+    # you want CMake to locate.
+    uv
+)
+
+target_link_libraries(skikobridge PUBLIC libace_napi.z.so)
+target_link_libraries(skikobridge PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/../../../libs/arm64-v8a/libskia.so)
+target_link_libraries(skikobridge PUBLIC libnative_vsync.so)
+target_link_libraries(skikobridge PUBLIC libhitrace_ndk.z.so)
+target_link_libraries(skikobridge PUBLIC ${EGL-lib} ${GLES-lib} ${hilog-lib} ${libace-lib} ${libnapi-lib} ${libuv-lib})
