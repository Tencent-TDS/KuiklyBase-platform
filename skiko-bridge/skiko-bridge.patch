diff --git a/skikobridge/src/main/cpp/src/nativeJsMain/cpp/shaper/FontMgrRunIterator.cpp b/skikobridge/src/main/cpp/src/nativeJsMain/cpp/shaper/FontMgrRunIterator.cpp
